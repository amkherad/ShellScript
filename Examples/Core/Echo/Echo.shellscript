#!/usr/bin/env shellscript
// echo is a special void statement (not a normal expression).

echo "plain string";
echo ('single quotes work too');

string name = "ShellScript";
int version = 1;

echo "name: " + name;
echo $"name: {name}, version {version}";

Assert.Equals("ShellScript", name);
Assert.Equals(1, version);
