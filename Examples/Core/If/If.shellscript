#!/usr/bin/env shellscript
// Conditional branches: if, else if, else.

int score = 85;
string grade;

if (score >= 90) {
    grade = "A";
} else if (score >= 80) {
    grade = "B";
} else if (score >= 70) {
    grade = "C";
} else {
    grade = "F";
}

echo $"Score {score} => grade {grade}";

if (score > 0 && score <= 100) {
    echo "Score is in valid range.";
}
