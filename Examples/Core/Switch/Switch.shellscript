#!/usr/bin/env shellscript
// switch / case (same structure as C#).

string command = "list";

switch (command) {
  case "help": {
    echo "Show help.";
  }
  case "list": {
    echo "List items.";
  }
  case "quit": {
    echo "Goodbye.";
  }
  default: {
    echo $"Unknown command: {command}";
  }
}

Assert.Equals("list", command);
