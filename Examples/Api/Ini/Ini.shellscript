#!/usr/bin/env shellscript
// @expect-out EXAMPLE_OK:Ini
// @expect-exit 0

string root = Environment.GetVariable("SHELLSCRIPT_EXAMPLE_ROOT");
string ini = Path.Combine(root, "app.ini");

Ini.SetValue(ini, "app", "key", "value");
string value = Ini.GetValue(ini, "app", "key");

echo value;
Assert.Equals("value", value);
echo "EXAMPLE_OK:Ini";
