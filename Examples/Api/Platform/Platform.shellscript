#!/usr/bin/env shellscript
// @expect-out EXAMPLE_OK:Platform
// @expect-exit 0

Platform.Call("true");
string text = Platform.CallString("echo platform-string");
int value = Platform.CallInteger("printf '%s' 9");

echo text;
echo $"value={value}";
Assert.Equals("platform-string", text);
Assert.Equals(9, value);
echo "EXAMPLE_OK:Platform";
