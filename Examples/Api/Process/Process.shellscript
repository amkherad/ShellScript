#!/usr/bin/env shellscript
// @expect-out EXAMPLE_OK:Process
// @expect-exit 0

int pid = Process.GetCurrentId();
bool running = Process.Exists(pid);
string captured = Process.RunAndCapture("printf capture-ok");

echo $"running={running}";
echo captured;
Assert.Equals("capture-ok", captured);
echo "EXAMPLE_OK:Process";
