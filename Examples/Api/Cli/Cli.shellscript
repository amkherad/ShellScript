#!/usr/bin/env shellscript
// @expect-out EXAMPLE_OK:Cli
// @expect-exit 0
// @args run --verbose value

int count = Cli.GetArgumentCount();
string first = Cli.GetArgument(0);
bool verbose = Cli.HasFlag("--verbose");

echo $"count={count}";
echo first;
echo $"verbose={verbose}";
Assert.True(count >= 0);
if (count > 0) {
  Assert.Equals("run", first);
  Assert.True(verbose);
}
echo "EXAMPLE_OK:Cli";
