string BsEmitBashHeader() {
  return "#!/usr/bin/env bash\n# Generated by ShellScript Bootstrap\n";
}

string BsEmitBashFromIr(string ir) {
  string scriptDir = Platform.GetScriptDirectory();
  string tmp = scriptDir + "/.bootstrap_ir_emit.txt";
  File.WriteAllText(tmp, ir);
  string py = scriptDir + "/bootstrap_emit.py";
  string cmd = "python3 '" + py + "' '" + tmp + "'";
  return BsEmitBashHeader() + Process.RunAndCapture(cmd);
}
